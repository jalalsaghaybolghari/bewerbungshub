# API server
PORT=3000

# MongoDB (matches docker-compose mongo service)
MONGO_URI=mongodb://localhost:27017/bewerbermanagementsystem

# Redis (matches docker-compose redis service, used by BullMQ from Phase 2 onward)
REDIS_URL=redis://localhost:6379

# MinIO / S3-compatible file storage (matches docker-compose minio service)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=bewerbermanagementsystem
