# API server
PORT=3000

# MongoDB. For local Docker use the docker-compose mongo service; without
# Docker, use a free MongoDB Atlas cluster instead (mongodb+srv://...).
MONGO_URI=mongodb://localhost:27017/bewerbermanagementsystem

# Redis (matches docker-compose redis service, used by BullMQ from Phase 2 onward)
REDIS_URL=redis://localhost:6379

# Auth. Generate real random values for anything beyond local dev, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_REFRESH_EXPIRES_IN=30d

# Sends the registration verification-code email via Resend
# (https://resend.com — free tier is plenty for this). Sign up, create an
# API key under API Keys, and set it below. MAIL_FROM can stay as Resend's
# shared onboarding@resend.dev sender for testing; for real deliverability,
# verify a sending domain (e.g. noreply@bewerbungshub.com) under Domains in
# the Resend dashboard first, then point MAIL_FROM at that address.
RESEND_API_KEY=
MAIL_FROM=BewerbungsHub <onboarding@resend.dev>

# CV file storage. STORAGE_DRIVER=local needs nothing else and stores files
# under STORAGE_LOCAL_DIR on disk (fine for solo/local dev, not for a real
# deployment). STORAGE_DRIVER=s3 talks to any S3-compatible endpoint (MinIO
# via docker-compose locally, real S3/R2/Azure Blob in prod) using the S3_*
# vars below.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=bewerbermanagementsystem
